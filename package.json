{
  "name": "racingedge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "model:setup": "python3 -m venv .venv && .venv/bin/pip install --upgrade pip && .venv/bin/pip install -r python/requirements.txt",
    "model:history": "cd python && ../.venv/bin/python -m racingedge_model.synthetic.generate_history --reset",
    "model:features": "cd python && ../.venv/bin/python -m racingedge_model.dataset",
    "model:train": "cd python && ../.venv/bin/python -m racingedge_model.train",
    "model:backtest": "cd python && ../.venv/bin/python -m racingedge_model.backtest",
    "model:predict": "cd python && ../.venv/bin/python -m racingedge_model.predict",
    "model:test": "cd python && ../.venv/bin/python -m pytest",
    "data:racingapi": "cd python && ../.venv/bin/python -m racingedge_data.cli.import_racing_api",
    "data:inspect": "cd python && ../.venv/bin/python -m racingedge_data.cli.inspect_dataset",
    "data:import-free": "cd python && ../.venv/bin/python -m racingedge_data.cli.import_free_dataset",
    "data:bias-report": "cd python && ../.venv/bin/python -m racingedge_data.cli.bias_analysis",
    "data:run-import-job": "cd python && ../.venv/bin/python -m racingedge_data.cli.run_import_job"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "clsx": "^2.1.1",
    "next": "16.3.0",
    "prisma": "^7.9.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
